digraph FourPrincipalControlPlane {
  graph [
    rankdir=TB,
    bgcolor="#F7F9FC",
    pad="0.42",
    nodesep="0.36",
    ranksep="0.58",
    splines=polyline,
    fontname="Helvetica",
    fontsize=23,
    labelloc="t",
    label="The Four-Principal Agent Identity Control Plane"
  ];

  // Color is reserved for principals; infrastructure stays neutral slate.
  node [
    shape=box,
    style="rounded,filled",
    color="#344054",
    penwidth=1.3,
    fontcolor="#101828",
    fillcolor="#F2F4F7",
    fontname="Helvetica",
    fontsize=12,
    margin="0.22,0.15"
  ];

  edge [
    color="#475467",
    fontcolor="#344054",
    fontname="Helvetica",
    fontsize=10,
    arrowsize=0.78,
    penwidth=1.18
  ];

  thesis [
    shape=note,
    label="Authentication proves who connected. The control plane must preserve\nwho requested, whose authority was used, which agent acted,\nand which identity reached the target.",
    fillcolor="#FFFFFF",
    color="#98A2B3",
    fontcolor="#344054",
    fontsize=11.5
  ];

  p1 [label="P1  REQUESTING PRINCIPAL\nWho initiated the task?", color="#1570EF", fillcolor="#EFF8FF", penwidth=2];
  p2 [label="P2  AUTHORITY SUBJECT\nWhose authority or data is exercised?", color="#0E9384", fillcolor="#F0FDF9", penwidth=2];
  p3 [label="P3  AGENT PRINCIPAL\nWhich autonomous workload acted?", color="#6938EF", fillcolor="#F4F3FF", penwidth=2];

  issuer [
    label="IDENTITY PROVIDER + WORKLOAD ISSUER\nValidate requester and agent credentials"
  ];

  ingress [
    label="INGRESS POLICY ENFORCEMENT POINT\nResolve principals • normalize target and arguments\ncompute action hash • classify environment"
  ];

  trusted [
    shape=folder,
    label="TRUSTED CONTROL DATA\nSigned policy bundle • entitlements • workload + execution issuer rules\ntarget-audience mapping • single-use approval bound to execution",
    fillcolor="#EAECF0"
  ];

  pdp [
    label="POLICY DECISION POINT\nTool + target + authority mode + risk + approval + trusted time"
  ];

  broker [
    label="CREDENTIAL BROKER / STS\nIssue short-lived, target-bound, sender-constrained authority"
  ];

  p4 [
    label="P4  EXECUTION PRINCIPAL\nWhich identity will the target authorize?",
    color="#DC6803",
    fillcolor="#FFF4ED",
    penwidth=2
  ];

  finalpep [
    label="MCP GATEWAY: FINAL ENFORCEMENT\nValidate the issued credential and exact target audience\nrecheck approval and unchanged action • allow or deny"
  ];

  resource [
    label="TARGET RESOURCE\nExecute only the authorized operation"
  ];

  // The only node that carries every accent, because it records every principal.
  audit [
    shape=cylinder,
    margin="0.26,0.17",
    label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="3" CELLPADDING="2">
<TR><TD COLSPAN="4"><B>CORRELATED AUDIT EVENT</B></TD></TR>
<TR>
<TD BGCOLOR="#EFF8FF"><FONT COLOR="#1570EF"><B>P1</B></FONT></TD>
<TD BGCOLOR="#F0FDF9"><FONT COLOR="#0E9384"><B>P2</B></FONT></TD>
<TD BGCOLOR="#F4F3FF"><FONT COLOR="#6938EF"><B>P3</B></FONT></TD>
<TD BGCOLOR="#FFF4ED"><FONT COLOR="#DC6803"><B>P4</B></FONT></TD>
</TR>
<TR><TD COLSPAN="4">policy • approval • action hash • result</TD></TR>
<TR><TD COLSPAN="4">Digest + external authenticity control</TD></TR>
</TABLE>>
  ];

  boundary [
    shape=note,
    label="TRUST BOUNDARY\nThe agent may propose an action and reference an approval ID.\nIt may not assert verified identity, entitlement, approval state,\naudience, issuer, or evaluation time.",
    fillcolor="#FFFFFF",
    color="#98A2B3",
    fontcolor="#475467",
    fontsize=10.5
  ];

  { rank=same; p1; p2; p3; }
  { rank=same; issuer; ingress; }
  { rank=same; trusted; pdp; }

  thesis -> p2 [style=invis];
  p1 -> p2 [style=invis, weight=100];
  p2 -> p3 [style=invis, weight=100];

  p1 -> issuer [label="authenticate", color="#1570EF"];
  p3 -> issuer [label="workload proof", color="#6938EF"];
  issuer -> ingress [label="verified identity claims"];
  p2 -> ingress [label="bounded authority context", color="#0E9384"];

  ingress -> pdp [label="pre-issuance decision"];
  trusted -> pdp [label="trusted facts", style=dashed];
  pdp -> broker [label="credential contract"];
  broker -> p4 [label="bounded credential", color="#DC6803"];
  p4 -> finalpep [label="actual issued credential", color="#DC6803"];
  finalpep -> resource [label="execute unchanged action"];
  resource -> audit [label="result"];
  audit -> boundary [style=invis];
}
