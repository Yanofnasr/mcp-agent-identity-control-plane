{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.internal/agent/agent-action-audit-event.schema.json",
  "title": "Agent action audit event",
  "description": "PII-minimized event preserving the requester, authority subject, agent principal, execution principal, action, policy decision, approval, and result.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event_id",
    "occurred_at",
    "requester",
    "authority_subject",
    "agent",
    "execution",
    "action",
    "context",
    "approval",
    "decision",
    "result",
    "evidence"
  ],
  "properties": {
    "schema_version": {
      "const": "1.1"
    },
    "event_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "requester": {
      "$ref": "#/$defs/audit_requester"
    },
    "authority_subject": {
      "$ref": "#/$defs/audit_authority_subject"
    },
    "agent": {
      "$ref": "#/$defs/agent"
    },
    "execution": {
      "$ref": "#/$defs/execution"
    },
    "action": {
      "$ref": "#/$defs/action"
    },
    "context": {
      "$ref": "#/$defs/audit_context"
    },
    "approval": {
      "$ref": "#/$defs/approval"
    },
    "decision": {
      "$ref": "#/$defs/decision"
    },
    "result": {
      "$ref": "#/$defs/result"
    },
    "evidence": {
      "$ref": "#/$defs/evidence"
    }
  },
  "$defs": {
    "audit_requester": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "principal_id",
        "principal_type"
      ],
      "properties": {
        "principal_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "principal_type": {
          "type": "string",
          "enum": [
            "human",
            "service",
            "workload"
          ]
        },
        "tenant_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      }
    },
    "audit_authority_subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "principal_id",
        "principal_type",
        "authority_basis"
      ],
      "properties": {
        "principal_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "principal_type": {
          "type": "string",
          "enum": [
            "human",
            "service",
            "workload"
          ]
        },
        "authority_basis": {
          "type": "string",
          "enum": [
            "explicit_delegation",
            "organizational_mandate",
            "agent_own_authority",
            "service_delegation"
          ]
        },
        "tenant_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      }
    },
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "agent_principal",
        "agent_definition_id",
        "agent_version",
        "runtime_instance_id",
        "credential_thumbprint",
        "credential_verified"
      ],
      "properties": {
        "agent_principal": {
          "type": "string",
          "pattern": "^(spiffe://|urn:).+",
          "maxLength": 1024
        },
        "agent_definition_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "agent_version": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "runtime_instance_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "mcp_client_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "credential_thumbprint": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "credential_verified": {
          "const": true
        }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authority_mode",
        "principal_id",
        "authority_subject_principal_id",
        "agent_actor_principal_id",
        "delegation_verified",
        "credential_type",
        "issuer",
        "audiences",
        "issued_at",
        "not_before",
        "expires_at",
        "sender_constraint",
        "credential_thumbprint",
        "credential_verified"
      ],
      "properties": {
        "authority_mode": {
          "type": "string",
          "enum": [
            "user_delegated",
            "agent_own",
            "brokered_service"
          ]
        },
        "principal_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "credential_type": {
          "type": "string",
          "enum": [
            "oauth_access_token",
            "x509_svid",
            "jwt_svid",
            "cloud_workload_token"
          ]
        },
        "issuer": {
          "type": "string",
          "format": "uri",
          "maxLength": 2048
        },
        "audiences": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "format": "uri",
            "maxLength": 2048
          }
        },
        "issued_at": {
          "type": "string",
          "format": "date-time"
        },
        "not_before": {
          "type": "string",
          "format": "date-time"
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        },
        "sender_constraint": {
          "type": "string",
          "enum": [
            "dpop",
            "mtls",
            "platform_bound"
          ]
        },
        "credential_thumbprint": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "credential_verified": {
          "const": true
        },
        "authority_subject_principal_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "agent_actor_principal_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "delegation_verified": {
          "const": true
        }
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mcp_server",
        "method",
        "tool",
        "target",
        "arguments_digest",
        "data_classification",
        "canonical_hash"
      ],
      "properties": {
        "mcp_server": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "method": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "tool": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "target": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "arguments_digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "data_classification": {
          "type": "string",
          "enum": [
            "public",
            "internal",
            "confidential",
            "restricted"
          ]
        },
        "canonical_hash": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      }
    },
    "audit_context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "session_id",
        "task_id",
        "correlation_id",
        "environment",
        "policy_bundle_digest"
      ],
      "properties": {
        "approval_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "session_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "task_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "correlation_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "environment": {
          "type": "string",
          "enum": [
            "development",
            "test",
            "staging",
            "production"
          ]
        },
        "policy_bundle_digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "prompt_context_hash": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required",
        "status"
      ],
      "properties": {
        "required": {
          "type": "boolean"
        },
        "status": {
          "type": "string",
          "enum": [
            "not_required",
            "approved",
            "denied",
            "expired",
            "missing"
          ]
        },
        "approval_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "approver_principal_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "action_hash": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "approved_at": {
          "type": "string",
          "format": "date-time"
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "required": {
                "const": true
              }
            }
          },
          "then": {
            "required": [
              "approval_id",
              "approver_principal_id",
              "action_hash",
              "approved_at",
              "expires_at"
            ]
          }
        }
      ]
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "outcome",
        "policy_id",
        "policy_version",
        "evaluated_at",
        "reason_codes",
        "risk_tier",
        "credential_profile",
        "credential_ttl_seconds"
      ],
      "properties": {
        "outcome": {
          "type": "string",
          "enum": [
            "allow",
            "allow_with_approval",
            "deny"
          ]
        },
        "policy_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "policy_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "evaluated_at": {
          "type": "string",
          "format": "date-time"
        },
        "reason_codes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "risk_tier": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high",
            "critical",
            "unknown"
          ]
        },
        "credential_profile": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "credential_ttl_seconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 86400
        }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "completed_at"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "success",
            "failure",
            "blocked",
            "cancelled"
          ]
        },
        "target_event_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "error_code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "completed_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_digest",
        "digest_profile",
        "retention_class",
        "contains_raw_credentials",
        "contains_raw_prompt"
      ],
      "properties": {
        "record_digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "digest_profile": {
          "type": "string",
          "enum": [
            "canonical-json-sort-keys-v1"
          ]
        },
        "evidence_uri": {
          "type": "string",
          "format": "uri",
          "maxLength": 2048
        },
        "retention_class": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "contains_raw_credentials": {
          "const": false
        },
        "contains_raw_prompt": {
          "type": "boolean"
        }
      }
    }
  }
}
