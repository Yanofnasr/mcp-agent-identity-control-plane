{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.internal/agent/authorization-context.schema.json",
  "title": "Verified MCP agent authorization context",
  "description": "Final-enforcement input assembled by a trusted policy enforcement point. Caller-controlled request references are intentionally separated from verified identity, action, and credential context.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request",
    "verified"
  ],
  "properties": {
    "schema_version": {
      "const": "1.3"
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "session_id",
        "task_id",
        "correlation_id"
      ],
      "properties": {
        "approval_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "session_id": {
          "description": "Application-level correlation identifier; not an MCP protocol session or Mcp-Session-Id header.",
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "task_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "correlation_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "verified": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requester",
        "authority_subject",
        "agent",
        "execution",
        "action",
        "context"
      ],
      "properties": {
        "requester": {
          "$ref": "#/$defs/requester"
        },
        "authority_subject": {
          "$ref": "#/$defs/authority_subject"
        },
        "agent": {
          "$ref": "#/$defs/agent"
        },
        "execution": {
          "$ref": "#/$defs/execution"
        },
        "action": {
          "description": "The final normalized live invocation reconstructed by the final policy enforcement point immediately before evaluation. It is not a caller-carried pre-issuance payload.",
          "$ref": "#/$defs/action"
        },
        "context": {
          "$ref": "#/$defs/context"
        }
      }
    }
  },
  "$defs": {
    "requester": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "principal_id",
        "principal_type"
      ],
      "properties": {
        "principal_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "principal_type": {
          "type": "string",
          "enum": [
            "human",
            "service",
            "workload"
          ]
        }
      }
    },
    "authority_subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "principal_id",
        "principal_type",
        "authority_basis"
      ],
      "properties": {
        "principal_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "principal_type": {
          "type": "string",
          "enum": [
            "human",
            "service",
            "workload"
          ]
        },
        "authority_basis": {
          "type": "string",
          "enum": [
            "explicit_delegation",
            "organizational_mandate",
            "agent_own_authority",
            "service_delegation"
          ]
        }
      }
    },
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "agent_principal",
        "agent_definition_id",
        "agent_version",
        "runtime_instance_id",
        "credential_type",
        "credential_issuer",
        "attestation_profile",
        "credential_thumbprint",
        "credential_verified"
      ],
      "properties": {
        "agent_principal": {
          "type": "string",
          "pattern": "^(spiffe://|urn:).+",
          "maxLength": 1024
        },
        "agent_definition_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "agent_version": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "runtime_instance_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "mcp_client_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "credential_type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "credential_issuer": {
          "type": "string",
          "format": "uri",
          "maxLength": 2048
        },
        "attestation_profile": {
          "type": "string",
          "format": "uri",
          "maxLength": 2048
        },
        "credential_thumbprint": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "credential_verified": {
          "const": true
        }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authority_mode",
        "principal_id",
        "authority_subject_principal_id",
        "agent_actor_principal_id",
        "authority_chain_verified",
        "credential_type",
        "issuer",
        "audiences",
        "issued_at",
        "not_before",
        "expires_at",
        "sender_constraint",
        "credential_thumbprint",
        "credential_verified"
      ],
      "properties": {
        "authority_mode": {
          "type": "string",
          "enum": [
            "user_delegated",
            "agent_own",
            "brokered_service"
          ]
        },
        "principal_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "credential_type": {
          "type": "string",
          "enum": [
            "oauth_access_token",
            "x509_svid",
            "jwt_svid",
            "cloud_workload_token"
          ]
        },
        "issuer": {
          "type": "string",
          "format": "uri",
          "maxLength": 2048
        },
        "audiences": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "format": "uri",
            "maxLength": 2048
          }
        },
        "issued_at": {
          "type": "string",
          "format": "date-time"
        },
        "not_before": {
          "type": "string",
          "format": "date-time"
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        },
        "sender_constraint": {
          "type": "string",
          "enum": [
            "dpop",
            "mtls",
            "platform_bound"
          ]
        },
        "credential_thumbprint": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "credential_verified": {
          "const": true
        },
        "authority_subject_principal_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "agent_actor_principal_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "authority_chain_verified": {
          "const": true
        }
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mcp_server",
        "method",
        "tool",
        "target",
        "arguments_digest",
        "data_classification",
        "canonical_hash"
      ],
      "properties": {
        "mcp_server": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\\r\\n]+$"
        },
        "method": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\\r\\n]+$"
        },
        "tool": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\\r\\n]+$"
        },
        "target": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048,
          "pattern": "^[^\\r\\n]+$"
        },
        "arguments_digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "data_classification": {
          "type": "string",
          "enum": [
            "public",
            "internal",
            "confidential",
            "restricted"
          ]
        },
        "canonical_hash": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "environment",
        "policy_bundle_digest"
      ],
      "properties": {
        "environment": {
          "type": "string",
          "enum": [
            "development",
            "test",
            "staging",
            "production"
          ]
        },
        "policy_bundle_digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      }
    }
  }
}
